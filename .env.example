# Copy to .env and adjust:  cp .env.example .env
# Every value below works out of the box for a local install.

# --- Web app ------------------------------------------------------------------

# Host interface the web UI/API is published on. 127.0.0.1 = this machine only.
# The app has no login, so use 0.0.0.0 only on a trusted network or behind an
# authenticating reverse proxy (see README).
APP_BIND_ADDRESS=127.0.0.1

# Host port for the web UI/API (container listens on 8000 internally).
APP_PORT=8080

# Log verbosity: critical, error, warning, info, debug.
LOG_LEVEL=info

# Maximum number of database connections the app keeps open.
DB_POOL_SIZE=5

# --- Database (PostgreSQL 16) -------------------------------------------------
# Used to create the database on first start AND by the app to connect.
# Changing them after the first start does not rename/alter the existing
# database - see "Common problems" in README.md.

# Database user name.
POSTGRES_USER=bookmarks

# Database password. CHANGE THIS before exposing the app beyond localhost,
# e.g.  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-local-only

# Database name.
POSTGRES_DB=bookmarks
